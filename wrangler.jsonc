{
  "name": "jananeeshop",
  "main": "worker.mjs",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jananee-db",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "jananee-uploads"
    }
  ],
  "vars": {
    "ADMIN_OWNER_EMAIL": "jcskumara05@gmail.com",
    "ADMIN_LOGIN_USERNAME": "jananee",
    "ADMIN_BOOTSTRAP_EMAIL": "jcskumara05@gmail.com"
  }
}
